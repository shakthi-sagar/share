# One authoritative configuration file. Copy this file to .env.
SHARE_ENV=development

# Public values used by the web app, CLI, and MCP clients.
SHARE_PUBLIC_WEB_URL=http://localhost:5173
SHARE_PUBLIC_API_URL=http://localhost:8787
SHARE_PUBLIC_DEFAULT_EXPIRY_SECONDS=604800

# Comma-separated browser origins allowed to call the API.
# Defaults to SHARE_PUBLIC_WEB_URL when omitted.
SHARE_ALLOWED_ORIGINS=http://localhost:5173

# Cloudflare Worker and storage resources.
CLOUDFLARE_WORKER_NAME=encrypted-share
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_NAME=encrypted-share
CLOUDFLARE_D1_ID=00000000-0000-0000-0000-000000000000
CLOUDFLARE_R2_BUCKET=encrypted-share-blobs
